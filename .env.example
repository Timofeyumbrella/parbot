# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (pnpm db:start prints the local keys; pnpm db:status prints them again)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI. The Gemini free tier needs no card: https://aistudio.google.com/apikey
# Leave GEMINI_API_KEY empty to run on the deterministic stub provider.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_CHAT_FALLBACKS=gemini-3.1-flash-lite,gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_THINKING_LEVEL=MINIMAL

# Billing. BILLING_PROVIDER=mock applies plan changes locally without Stripe.
BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_YEARLY=

# Public key of the assistant behind the landing page's ⌘K palette. Leave empty to leave the
# palette off; the hero's example conversation is scripted either way.
NEXT_PUBLIC_DEMO_ASSISTANT_KEY=
